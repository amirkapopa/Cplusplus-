        <!-- OOP Concept group box -->
        <item>
         <widget class="QGroupBox" name="conceptBox">
          <property name="title"><string>OOP Concept: Static Member Variable</string></property>
          <layout class="QVBoxLayout" name="conceptLayout">
           <property name="leftMargin"><number>14</number></property>
           <property name="topMargin"><number>8</number></property>
           <property name="rightMargin"><number>14</number></property>
           <property name="bottomMargin"><number>14</number></property>
           <property name="spacing"><number>8</number></property>
           <item>
            <layout class="QHBoxLayout" name="staticRow">
             <item>
              <widget class="QLabel" name="conceptLabel">
               <property name="text">
                <string>Book objects in memory right now  (Book::bookCount):</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QLabel" name="statBookObjects">
               <property name="text"><string>—</string></property>
