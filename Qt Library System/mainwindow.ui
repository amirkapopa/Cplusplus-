               </property>
              </spacer>
             </item>
            </layout>
           </item>
           <item>
            <widget class="QLabel" name="conceptExplanation">
             <property name="text">
              <string>A static member belongs to the class itself, not to any single object.
Book::bookCount increments in the Book constructor and decrements in the destructor.
You can read it without creating a Book instance:   Book::getBookCount()</string>
             </property>
             <property name="wordWrap"><bool>true</bool></property>
            </widget>
           </item>
          </layout>
         </widget>
